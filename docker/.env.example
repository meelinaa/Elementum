# MySQL (wird von mysql- und api-Container genutzt)
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
MYSQL_DATABASE=Elementum-Database
MYSQL_USER=<MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>
MYSQL_PORT=3307
REDIS_PORT=6379

# API
API_PORT=5000

# Worker (Elementum-WorkerService — host port mapped into the container)
WORKER_PORT=5094

# Production CORS (Compose API runs as ASPNETCORE_ENVIRONMENT=Production).
# Browser origin allowed by FrontendPolicy. Use https://… in real deployments.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Reverse proxy (docker compose --profile edge): TLS termination in Caddy, not in the API.
# SITE_ADDRESS=https://api.example.com enables Let's Encrypt when ports 80/443 are public.
SITE_ADDRESS=https://localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
